{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange.report.v1",
  "title": "Orange Report v1",
  "type": "object",
  "required": ["schema", "orderId", "status", "confidence", "actionsTaken", "evidence", "blockers", "nextAction", "receiptPath"],
  "properties": {
    "schema": { "const": "orange.report.v1" },
    "orderId": { "type": "string", "minLength": 3 },
    "status": { "type": "string", "minLength": 2 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "actionsTaken": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "nextAction": { "type": "string" },
    "receiptPath": { "type": "string", "minLength": 1 },
    "ae_lane": { "type": "string" },
    "ae_host": { "type": "string" }
  },
  "additionalProperties": true
}
