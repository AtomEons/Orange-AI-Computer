{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orange5.receipt.v0",
  "title": "Orange5 Receipt v0",
  "type": "object",
  "required": ["receipt_id", "generated_at", "schema", "actor", "status", "confidence", "hash_chain"],
  "properties": {
    "receipt_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "schema": { "const": "orange5.receipt.v0" },
    "actor": { "type": "string" },
    "sovereign": { "type": "string" },
    "status": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "prior_receipt": { "type": ["string", "null"] },
    "hash_chain": { "type": "integer", "minimum": 1 },
    "actions": { "type": "array" },
    "evidence": { "type": "array" },
    "blockers": { "type": "array" },
    "next_action": { "type": "string" },
    "rollback": { "type": "string" }
  },
  "additionalProperties": true
}
