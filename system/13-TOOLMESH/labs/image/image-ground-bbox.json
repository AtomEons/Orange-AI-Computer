{
  "schema": "orange5.tool-card.v0",
  "lab": "image",
  "card_id": "image-ground-bbox",
  "capability": "image.ground.bbox",
  "cost_class": "free",
  "latency_class": "seconds",
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": ["image_ref", "query"],
    "properties": {
      "image_ref": {
        "type": "string",
        "description": "Sandbox reference to the image to ground. Inline data URLs are also accepted for small payloads.",
        "minLength": 8,
        "maxLength": 4096
      },
      "query": {
        "type": "string",
        "description": "Natural-language phrase identifying the object(s) to locate (e.g. 'the red mug on the left', 'submit button').",
        "minLength": 1,
        "maxLength": 512
      },
      "max_boxes": {
        "type": "integer",
        "description": "Maximum number of bounding boxes to return. Detector returns highest-confidence first; ties broken by area.",
        "minimum": 1,
        "maximum": 50,
        "default": 5
      },
      "min_confidence": {
        "type": "number",
        "description": "Minimum confidence threshold in [0,1]. Boxes below this score are dropped before truncation to max_boxes.",
        "minimum": 0,
        "maximum": 1,
        "default": 0.25
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": ["boxes", "image_width", "image_height", "model"],
    "properties": {
      "boxes": {
        "type": "array",
        "description": "Detected bounding boxes. Coordinates are absolute pixels in the source image's coordinate system: x,y is the top-left corner, w,h are width/height. Empty array is a valid 'no detections' result.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "w", "h", "confidence", "label"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "w": { "type": "integer", "minimum": 1 },
            "h": { "type": "integer", "minimum": 1 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "label": {
              "type": "string",
              "description": "Detector's free-text label for this region. Often a near-quote of the query.",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      },
      "image_width": { "type": "integer", "minimum": 1, "maximum": 16384 },
      "image_height": { "type": "integer", "minimum": 1, "maximum": 16384 },
      "model": {
        "type": "string",
        "description": "Detector identity for receipt citation.",
        "const": "orange-eye"
      }
    }
  },
  "default_lease_template": {
    "ttl_seconds": 300,
    "max_invocations": 50,
    "scopes": [
      "fs.read:sandbox://images/",
      "model.invoke:orange-eye",
      "net.egress:none"
    ],
    "human_approval_required": false,
    "rate_limit_per_minute": 30
  },
  "risk_class": "read-only",
  "last_verified_at": "2026-06-25T00:15:22Z",
  "vendor": "self-hosted",
  "version": "0.1.0",
  "summary": "Open-vocabulary bounding-box grounding via the self-hosted OrangeEye detector; query in, pixel-space boxes out.",
  "tags": ["vision", "grounding", "bbox", "detection", "orange-eye"]
}
