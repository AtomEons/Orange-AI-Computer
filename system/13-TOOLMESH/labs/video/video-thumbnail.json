{
  "schema": "orange5.tool-card.v0",
  "lab": "video",
  "card_id": "video-thumbnail",
  "capability": "video.thumbnail",
  "cost_class": "free",
  "latency_class": "seconds",
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source_ref"],
    "properties": {
      "source_ref": {
        "type": "string",
        "pattern": "^sandbox://",
        "description": "Sandbox reference to the source video.",
        "minLength": 11,
        "maxLength": 4096
      },
      "timestamps_seconds": {
        "type": "array",
        "description": "Explicit timestamps (seconds, float allowed) to capture frames at. Mutually exclusive with 'count'.",
        "items": { "type": "number", "minimum": 0 },
        "minItems": 1,
        "maxItems": 32,
        "uniqueItems": true
      },
      "count": {
        "type": "integer",
        "description": "If timestamps_seconds is omitted, runner samples this many frames at uniform intervals across the source duration.",
        "minimum": 1,
        "maximum": 32
      },
      "max_width": {
        "type": "integer",
        "description": "Resize thumbnails so width does not exceed this. Aspect ratio preserved.",
        "minimum": 32,
        "maximum": 3840,
        "default": 640
      },
      "format": {
        "type": "string",
        "enum": ["jpg", "png", "webp"],
        "default": "jpg"
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": ["thumbnails"],
    "properties": {
      "thumbnails": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image_ref", "timestamp_seconds", "width", "height"],
          "properties": {
            "image_ref": {
              "type": "string",
              "pattern": "^sandbox://",
              "minLength": 11,
              "maxLength": 4096
            },
            "timestamp_seconds": { "type": "number", "minimum": 0 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "default_lease_template": {
    "ttl_seconds": 300,
    "max_invocations": 30,
    "scopes": [
      "fs.read:sandbox://video/",
      "fs.write:sandbox://video/thumbs/",
      "process.spawn:ffmpeg",
      "net.egress:none"
    ],
    "human_approval_required": false,
    "rate_limit_per_minute": 30
  },
  "risk_class": "sandboxed",
  "last_verified_at": "2026-06-25T00:18:00Z",
  "vendor": "self-hosted",
  "version": "0.1.0",
  "summary": "Frame-accurate thumbnail extraction from a sandboxed video at explicit timestamps or uniform sampling.",
  "tags": ["video", "thumbnail", "preview", "ffmpeg"],
  "notes": "Uses ffmpeg seek with -ss before -i for fast keyframe-aligned seek; for sub-keyframe accuracy the runner falls back to slower exact-seek and may extend latency to the upper end of the seconds bucket."
}
