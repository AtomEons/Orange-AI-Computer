{
  "schema": "orange5.tool-card.v0",
  "lab": "automation",
  "card_id": "webhook-listen",
  "capability": "automation.webhook",
  "cost_class": "free",
  "latency_class": "sub-second",
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": ["action"],
    "properties": {
      "action": {
        "type": "string",
        "description": "Lifecycle verb against the operator's webhook endpoints.",
        "enum": ["register", "deregister", "list", "rotate-secret", "tail-events"]
      },
      "endpoint": {
        "type": "object",
        "description": "Required for register/deregister/rotate-secret.",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "target_capability": {
            "type": "string",
            "description": "Capability invoked when an event arrives. Receives the request body as 'payload' and the verified headers as 'headers'.",
            "minLength": 3,
            "maxLength": 128
          },
          "signature_scheme": {
            "type": "string",
            "description": "Required inbound authentication scheme. Unsigned public ingress is not supported.",
            "enum": ["hmac-sha256", "github", "stripe", "slack"],
            "default": "hmac-sha256"
          },
          "allowed_event_types": {
            "type": "array",
            "description": "Optional filter — only events whose type matches one of these strings are forwarded.",
            "items": { "type": "string", "minLength": 1, "maxLength": 128 },
            "maxItems": 64
          },
          "max_body_bytes": {
            "type": "integer",
            "description": "Hard upper bound on inbound request body size. Larger bodies are 413'd at the edge before reaching the handler.",
            "minimum": 1024,
            "maximum": 10485760,
            "default": 1048576
          }
        }
      },
      "tail": {
        "type": "object",
        "description": "Options for action='tail-events'.",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "since": { "type": "string", "description": "ISO-8601 timestamp; events strictly after this are returned." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 50 }
        }
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": ["action", "status"],
    "properties": {
      "action": { "type": "string" },
      "status": { "type": "string", "enum": ["registered", "deregistered", "rotated", "listed", "tailed", "failed"] },
      "endpoint_url": {
        "type": "string",
        "description": "Mesh-owned ingress URL. Includes the per-operator subdomain; the secret is delivered separately via the receipts channel."
      },
      "secret_fingerprint": {
        "type": "string",
        "description": "Short hash of the active signing secret. Full secret is never returned in the response — fetch via the secrets card."
      },
      "endpoints": {
        "type": "array",
        "description": "Populated for action='list'.",
        "items": {
          "type": "object",
          "required": ["name", "endpoint_url", "signature_scheme"],
          "properties": {
            "name": { "type": "string" },
            "endpoint_url": { "type": "string" },
            "signature_scheme": { "type": "string" },
            "target_capability": { "type": "string" },
            "created_at": { "type": "string" },
            "last_event_at": { "type": "string" }
          }
        }
      },
      "events": {
        "type": "array",
        "description": "Populated for action='tail-events'. Bodies are truncated to 8 KB; full bodies live in the receipt store.",
        "items": {
          "type": "object",
          "required": ["event_id", "received_at", "event_type"],
          "properties": {
            "event_id": { "type": "string" },
            "received_at": { "type": "string" },
            "event_type": { "type": "string" },
            "signature_verified": { "type": "boolean" },
            "body_preview": { "type": "string" }
          }
        }
      }
    }
  },
  "default_lease_template": {
    "ttl_seconds": 900,
    "max_invocations": 30,
    "scopes": [
      "webhook.read",
      "webhook.write",
      "secrets.write:webhook",
      "net.egress:none"
    ],
    "human_approval_required": true,
    "rate_limit_per_minute": 12
  },
  "risk_class": "external-side-effect",
  "last_verified_at": "2026-06-25T00:15:22Z",
  "vendor": "self-hosted",
  "version": "0.1.0",
  "summary": "Register and manage authenticated inbound webhooks that dispatch to mesh capabilities. HMAC-SHA256 by default; vendor schemes for GitHub/Stripe/Slack supported.",
  "tags": ["automation", "webhook", "ingress", "hmac", "events"],
  "notes": "Registration fails closed unless a supported signature scheme is configured. Unsigned ingress is prohibited: sources that cannot sign must use an authenticated gateway that verifies the source before forwarding to this endpoint."
}
