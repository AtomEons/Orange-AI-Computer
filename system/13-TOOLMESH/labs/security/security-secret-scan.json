{
  "schema": "orange5.tool-card.v0",
  "lab": "security",
  "card_id": "security-secret-scan",
  "capability": "security.secret.scan",
  "cost_class": "free",
  "latency_class": "seconds",
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": ["target_ref"],
    "properties": {
      "target_ref": {
        "type": "string",
        "description": "Sandbox reference — a file or a directory. Runner walks directories recursively up to a depth ceiling.",
        "pattern": "^sandbox://",
        "minLength": 11,
        "maxLength": 4096
      },
      "engine": {
        "type": "string",
        "description": "Vetted detector to invoke. Runner maps to a pinned binary; arbitrary detectors are rejected.",
        "enum": ["gitleaks", "trufflehog", "internal-grep"],
        "default": "gitleaks"
      },
      "include_globs": {
        "type": "array",
        "items": { "type": "string", "minLength": 1, "maxLength": 256 },
        "maxItems": 50,
        "uniqueItems": true
      },
      "exclude_globs": {
        "type": "array",
        "items": { "type": "string", "minLength": 1, "maxLength": 256 },
        "maxItems": 50,
        "uniqueItems": true
      },
      "verify_live": {
        "type": "boolean",
        "description": "When true, the runner attempts to validate that detected credentials are LIVE against their issuing service. Disabled by default — flips risk class to external-side-effect at lease issuance.",
        "default": false
      }
    }
  },
  "outputs": {
    "type": "object",
    "additionalProperties": false,
    "required": ["findings", "files_scanned", "engine"],
    "properties": {
      "engine": { "type": "string", "minLength": 1, "maxLength": 32 },
      "files_scanned": { "type": "integer", "minimum": 0 },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "line", "rule_id", "severity"],
          "properties": {
            "file": { "type": "string", "maxLength": 4096 },
            "line": { "type": "integer", "minimum": 1 },
            "rule_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
            "match_excerpt": {
              "type": "string",
              "description": "Redacted excerpt. The runner replaces the credential body with '<REDACTED>'; the full match is NEVER returned, only fingerprinted.",
              "maxLength": 500
            },
            "fingerprint": { "type": "string", "minLength": 1, "maxLength": 128 },
            "live_verified": { "type": "boolean" }
          }
        }
      }
    }
  },
  "default_lease_template": {
    "ttl_seconds": 600,
    "max_invocations": 20,
    "scopes": [
      "fs.read:sandbox://workspace/",
      "process.spawn:gitleaks",
      "process.spawn:trufflehog",
      "net.egress:none"
    ],
    "human_approval_required": false,
    "rate_limit_per_minute": 6
  },
  "risk_class": "read-only",
  "last_verified_at": "2026-06-25T00:28:00Z",
  "vendor": "self-hosted",
  "version": "0.1.0",
  "summary": "Static secret-leak scanner (gitleaks/trufflehog) over a sandbox path. Outputs are redacted and fingerprinted, never raw.",
  "tags": ["security", "secrets", "gitleaks", "trufflehog", "read-only"],
  "notes": "verify_live=true is gated separately — turning it on requires the operator to issue a lease that includes the relevant net.egress scopes AND human_approval_required, because validating a credential is itself a credential-using side effect."
}
