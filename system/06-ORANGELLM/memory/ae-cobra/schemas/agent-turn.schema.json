{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atomeons/orange5/schemas/agent-turn.v0.json",
  "title": "AgentTurn",
  "description": "Output shape for Æ Cobra memory daemon. GBNF-enforced at logit layer; JSON Schema enforced at parser layer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lane", "event_type", "summary", "entities", "files", "commands", "risk", "next_action", "confidence"],
  "properties": {
    "lane": {
      "type": "string",
      "enum": ["reality", "thought", "merge"],
      "description": "Reality = ground truth from origin. Thought = hypothesis/plan/rejected. Merge = synthesized."
    },
    "event_type": {
      "type": "string",
      "enum": ["observation", "decision", "error", "checkpoint", "recall", "receipt", "risk"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "entities": {
      "type": "array",
      "items": { "type": "string", "maxLength": 80 },
      "maxItems": 20
    },
    "files": {
      "type": "array",
      "items": { "type": "string", "maxLength": 240 },
      "maxItems": 20
    },
    "commands": {
      "type": "array",
      "items": { "type": "string", "maxLength": 240 },
      "maxItems": 20
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
