[Unit]
Description=AE Flow scheduler (Orange5 05-FLOW pressure-field tick driver)
Documentation=file:///opt/atomeons/Orange5/05-FLOW/PR-05-SPEC.md
After=network.target
Wants=network-online.target

[Service]
Type=simple
# Adjust user/group to whatever owns the Orange5 install on the host.
User=atomeons
Group=atomeons

# WorkingDirectory MUST be 05-FLOW so relative state/ and scheduler.config.json resolve.
WorkingDirectory=/opt/atomeons/Orange5/05-FLOW
ExecStart=/usr/bin/env node /opt/atomeons/Orange5/05-FLOW/scheduler.mjs

# SIGHUP triggers in-process config reload (no restart needed).
ExecReload=/bin/kill -HUP $MAINPID

# Graceful shutdown: scheduler honours SIGTERM with a grace window (default 2s).
KillSignal=SIGTERM
TimeoutStopSec=10

# Resilience: restart on crash, but cap thrash.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Structured stdout/stderr go straight to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ae-flow-scheduler

# Hardening — scheduler only needs to read its dir and write state/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/atomeons/Orange5/05-FLOW/state
ReadOnlyPaths=/opt/atomeons/Orange5/05-FLOW
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Resource ceiling — tick is cheap; if we exceed this something is wrong.
MemoryHigh=256M
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
